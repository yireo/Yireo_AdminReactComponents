/** @version 1.0.6 */

use Magento\Backend\Block\Template;
use Magento\Framework\View\Helper\SecureHtmlRenderer;

/** @var Template $block */
/** @var SecureHtmlRenderer $secureRenderer */

$urls = [
    'customerSearchAjaxUrl' => $block->getUrl('yireo_react/ajax/customerSearch'),
    'productSearchAjaxUrl' => $block->getUrl('yireo_react/ajax/productSearch'),
    'orderSearchAjaxUrl' => $block->getUrl('yireo_react/ajax/orderSearch'),
    'customerLabelAjaxUrl' => $block->getUrl('yireo_react/ajax/customerLabel'),
    'productLabelAjaxUrl' => $block->getUrl('yireo_react/ajax/productLabel'),
    'orderLabelAjaxUrl' => $block->getUrl('yireo_react/ajax/orderLabel'),
];

$json = json_encode($urls, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR);
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], 'window.yireo_react = ' . $json . ';', false) ?>
